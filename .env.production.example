# Production (docker-compose.prod.yml).  cp .env.production.example .env.production
# Read by the app + migrate containers AND by compose itself (--env-file) for the MinIO container.

# --- compose ---
# APP_IMAGE=tbkk-pcw          # or registry.example.com/tbkk-pcw to pull instead of build
# APP_TAG=latest
# APP_PORT=3000
# MINIO_CONSOLE_PORT=9101     # bound to 127.0.0.1 only
# MINIO_IMAGE=pgsty/minio:RELEASE.2026-08-04T00-00-00Z   # or a copy in the company registry

# --- database: company MySQL server (create the empty schema; migrations run on start) ---
DATABASE_URL=mysql://user:password@db-host:3306/tbkk_pcw

# --- auth ---
AUTH_SECRET=change-me-to-a-random-string-of-at-least-32-chars
AUTH_PROVIDERS=ad,local
AD_LOGIN_URL=http://192.168.161.102:9999/login
AD_AUTO_PROVISION=true
COOKIE_SECURE=true
APP_URL=https://pcw.tbkk.co.th

# --- evidence files: the bundled `minio` service ---
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=pcw-evidence

# --- mail: company relay ---
SMTP_HOST=
SMTP_PORT=25
MAIL_FROM=project-control@tbkk.co.th
CRON_SECRET=

# --- AI (optional, see .env.example) ---
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=
GEMINI_API_KEY=
