# Copy to .env.local and fill in
DATABASE_URL=mysql://user:password@127.0.0.1:3306/tbkk_pcw
# npm run docker:up — the same database seen from a container (MAMP on the host)
# DOCKER_DATABASE_URL=mysql://user:password@host.docker.internal:8889/tbkk_pcw

AUTH_SECRET=change-me-to-a-random-string-of-at-least-32-chars
# ad | local | ad,local
AUTH_PROVIDERS=ad,local
AD_LOGIN_URL=http://192.168.161.102:9999/login
AD_AUTO_PROVISION=true
# AD_TIMEOUT_MS=8000
# SESSION_HOURS=12
# COOKIE_SECURE=true   # when served over HTTPS
# login lockout: failed attempts per username / per IP within the window
# LOGIN_MAX_FAILS=5
# LOGIN_MAX_FAILS_IP=30
# LOGIN_WINDOW_MINUTES=15

MINIO_ENDPOINT=127.0.0.1
MINIO_PORT=9100
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=pcw-evidence
# EVIDENCE_MAX_MB=50
# EVIDENCE_EXTRA_TYPES=dwg,step   # extra evidence extensions beyond the built-in list (always downloaded)

SMTP_HOST=
SMTP_PORT=25
# SMTP_USER=
# SMTP_PASS=
MAIL_FROM=project-control@tbkk.co.th
APP_URL=http://localhost:3000
CRON_SECRET=

# Scheduler (node-cron inside the app). Run it on one instance only.
# DISABLE_SCHEDULER=true
# CRON_NOTIFICATION_SCAN=0 * * * *
# CRON_KPI_SNAPSHOT=0 6 * * 1

# AI follow-up questions before a request is submitted — any OpenAI-compatible Chat Completions API
# (company LLM gateway, OpenAI, Ollama at http://127.0.0.1:11434/v1 …). Base URL includes the version path, e.g. …/v1.
# Leave OPENAI_BASE_URL empty to turn it off; requests are then submitted without questions.
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=
# OPENAI_TIMEOUT_MS=60000

# Google Gemini Live — only for talking with the assistant (voice) in the pre-submit chat; the LLM above still checks
# the answers and writes the summaries. Leave empty to turn voice off. The browser needs HTTPS (or localhost) for the mic.
# The request form and the conversation are sent to Google during a voice chat.
GEMINI_API_KEY=
# GEMINI_LIVE_MODEL=gemini-3.8-live
# GEMINI_LIVE_VOICE=Kore

# Live cursors / dragging on the Design tab: the realtime WebSocket service (npm run realtime, port 3001).
# Leave REALTIME_PUBLIC_URL empty locally — the app then uses ws://<app host>:3001/realtime.
# REALTIME_PORT=3001
# REALTIME_PUBLIC_URL=
